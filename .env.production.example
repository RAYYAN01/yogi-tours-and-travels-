# =============================================================================
# Production environment variables for the NEW Vercel project.
#
# These are NOT read from a file in production — set each one in:
#   Vercel  ->  Project  ->  Settings  ->  Environment Variables
#   (add to BOTH "Production" and "Preview")
#
# This file is only a checklist / copy-paste source and holds NO real secrets.
# Fill values in from your local .env when entering them into Vercel, but do
# NOT commit a copy with real secrets filled in.
# =============================================================================

# --- Core ---
NODE_ENV=production
# Canonical public URL — used for sitemap, canonical tags, WhatsApp links, SEO.
# MUST be the real domain, NOT localhost.
SITE_URL=https://www.yogitourstravels.com

# --- Database (external Neon Postgres — unchanged by the account switch) ---
# Copy verbatim from your local .env
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Session / security ---
# Copy from local .env, or generate a fresh one with: openssl rand -hex 32
# (a new value just invalidates existing admin login sessions)
SESSION_SECRET=

# 32-byte hex (openssl rand -hex 32). Encrypts enquiry name/phone/email at rest.
# Reuse the value from your local .env — existing enquiry rows are still
# plaintext and decrypt-through, so no data migration is needed.
ENCRYPTION_KEY=

# --- Redis cache (optional) ---
# From the Vercel Marketplace "Upstash Redis" integration (or upstash.com
# directly) — REST credentials, not a redis:// URL. Leave both blank to run
# with no cache: the site works identically, just without the DB/page cache
# that cuts Postgres reads and render work on repeat requests.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin panel login ---
# Only consumed by `npm run seed` on an EMPTY admin_users table. The live DB is
# already seeded, so these mostly don't matter now — set them anyway for parity.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Business contact details (shown across the site) ---
BUSINESS_PHONE=+91 98867 70099
BUSINESS_WHATSAPP=+91 98867 70099
BUSINESS_EMAIL=info@yogitourstravels.com

# --- Analytics / SEO (optional) ---
# NOT in your local .env — copy from the OLD Vercel project's env vars before
# you lose access to that dashboard. Leave blank to disable each feature.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# --- Outbound email for enquiry notifications (optional, currently unused) ---
# Leave blank: enquiries are still saved to the DB and shown in /admin, the
# app just skips the email notification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
