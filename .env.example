# Copy this file to .env and fill in real values before deploying to production.
# Nothing in this file is a real credential — every value below is a placeholder.

# --- Server ---
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# --- Database (Postgres — required, including for local dev) ---
# From your Vercel Postgres / Neon / Supabase dashboard. Can point at the
# same remote database for both local dev and production.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Session / security ---
# Generate a real random string for production, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-this-to-a-long-random-string

# --- Admin panel login (seeded on first run via `npm run seed`) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# --- Business contact placeholders (shown across the site until replaced) ---
BUSINESS_PHONE=+91 97410 32020
BUSINESS_WHATSAPP=+91 98867 70099
BUSINESS_EMAIL=info@yogitourstravels.com

# --- Outbound email for enquiry notifications (optional) ---
# If left blank, enquiries are still saved to the database and visible in /admin,
# the site just skips sending an email notification and logs a note instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
