<%- include('../partials/page-start') %>

<section class="py-24 lg:py-32">
  <div class="container max-w-lg text-center">
    <span class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-error/10 text-error mb-6">
      <%- include('../partials/icon', { name: 'alert-circle', cls: 'w-8 h-8' }) %>
    </span>
    <p class="font-display text-sm font-semibold tracking-widest text-error uppercase mb-2">Error</p>
    <h1 class="font-display font-bold text-2xl sm:text-3xl text-ink-900">Something Went Wrong</h1>
    <p class="text-ink-500 text-[15px] leading-relaxed mt-3">We hit an unexpected error. Please try again, or reach us directly and we'll help right away.</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
      <a href="/" class="btn btn-primary">Back to Home</a>
      <a href="<%= telHref %>" class="btn btn-outline">Call <%= business.phone %></a>
    </div>
  </div>
</section>

<%- include('../partials/page-end') %>
