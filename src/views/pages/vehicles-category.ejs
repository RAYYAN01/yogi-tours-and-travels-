<%- include('../partials/page-start') %>
<%- include('../partials/breadcrumbs') %>

<section class="py-14 lg:py-20">
  <div class="container">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-[0.14em] uppercase text-brand-600 mb-3">
        <span class="w-6 h-px bg-brand-500"></span>Fleet
      </span>
      <h1 class="font-display font-bold text-3xl sm:text-4xl text-ink-900 tracking-tight"><%= rentalLabel %> Rental in Bangalore</h1>
      <p class="text-ink-500 text-[15px] sm:text-base leading-relaxed mt-4"><%= intro %></p>
    </div>
  </div>
</section>

<section class="pb-16 lg:pb-24">
  <div class="container">
    <% if (vehicles.length === 0) { %>
      <p class="text-ink-500">No vehicles listed in this category yet — <a href="/contact" class="text-brand-700 font-semibold">contact us</a> and we'll help find the right fit.</p>
    <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6">
      <% vehicles.forEach(function(v) { %>
        <%- include('../components/vehicle-card', { vehicle: v, showCategory: false }) %>
      <% }); %>
    </div>
    <% } %>
  </div>
</section>

<section class="py-16 lg:py-24 bg-ink-50/60">
  <div class="container max-w-3xl">
    <%- include('../components/section-heading', { eyebrow: 'Other Categories', heading: 'Looking for a Different Vehicle Size?', align: 'center' }) %>
    <div class="flex flex-wrap justify-center gap-2.5 mt-8">
      <% Object.entries(vehicleCategoryLabels).forEach(function(entry) { if (entry[0] === category) return; %>
        <a href="/fleet/<%= entry[0] %>" class="badge badge-outline hover:border-brand-400 hover:text-brand-700 transition-colors !py-2 !px-3.5 text-[13px]">
          <%- include('../partials/icon', { name: vehicleCategoryIcon(entry[0]), cls: 'w-3.5 h-3.5' }) %><%= entry[1] %>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<%- include('../partials/cta-section') %>
<%- include('../partials/page-end') %>
