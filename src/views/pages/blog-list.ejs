<%- include('../partials/page-start') %>
<%- include('../partials/breadcrumbs') %>

<section class="pb-16 lg:pb-24 pt-10 lg:pt-14">
  <div class="container">
    <h1 class="font-display font-bold text-3xl sm:text-4xl text-ink-900 tracking-tight">Travel Tips &amp; Guides</h1>
    <p class="text-[15px] text-ink-600 leading-relaxed mt-4 max-w-2xl">Practical guides on choosing the right vehicle, planning outstation trips from Bangalore, airport transfers and group travel.</p>

    <div class="mt-10">
    <% if (posts.length === 0) { %>
      <p class="text-ink-500">No articles published yet — check back soon.</p>
    <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
      <% posts.forEach(function(post) { %>
      <article class="flex flex-col h-full bg-white rounded-2xl border border-ink-100 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-300">
        <a href="/blog/<%= post.slug %>" class="relative block aspect-[16/10] overflow-hidden rounded-t-2xl">
          <%- include('../components/smart-image', { src: post.coverImageKey, seed: post.slug, icon: 'route', label: '', alt: post.title, cls: 'w-full h-full hover:scale-105 transition-transform duration-500' }) %>
        </a>
        <div class="p-5 flex flex-col flex-1">
          <p class="text-xs text-ink-400"><%= new Date(post.publishedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
          <h2 class="font-display font-semibold text-[17px] text-ink-900 leading-snug mt-1.5">
            <a href="/blog/<%= post.slug %>" class="hover:text-brand-700 transition-colors"><%= post.title %></a>
          </h2>
          <p class="text-sm text-ink-500 mt-2.5 leading-relaxed line-clamp-3 flex-1"><%= post.excerpt %></p>
          <a href="/blog/<%= post.slug %>" class="inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800 mt-4">
            Read Article <%- include('../partials/icon', { name: 'arrow-right', cls: 'w-3.5 h-3.5' }) %>
          </a>
        </div>
      </article>
      <% }); %>
    </div>
    <% } %>
    </div>
  </div>
</section>

<%- include('../partials/cta-section') %>
<%- include('../partials/page-end') %>
