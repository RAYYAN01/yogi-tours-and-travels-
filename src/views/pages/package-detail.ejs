<%- include('../partials/page-start') %>
<%- include('../partials/breadcrumbs') %>

<section class="py-10 lg:py-16">
  <div class="container grid lg:grid-cols-5 gap-8 lg:gap-12">
    <div class="lg:col-span-3">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="badge badge-brand"><%= pkg.travelCategory %></span>
        <span class="badge badge-outline"><%- include('../partials/icon', { name: 'clock', cls: 'w-3 h-3' }) %><%= pkg.duration %></span>
        <span class="badge badge-outline"><%- include('../partials/icon', { name: 'map-pin', cls: 'w-3 h-3' }) %>From <%= pkg.startLocation %></span>
      </div>
      <h1 class="font-display font-bold text-3xl text-ink-900 tracking-tight"><%= pkg.title %></h1>
      <p class="text-ink-500 text-[15px] leading-relaxed mt-3"><%= pkg.idealFor %></p>

      <div class="rounded-2xl overflow-hidden shadow-card aspect-[16/9] mt-8">
        <%- include('../components/smart-image', { src: pkg.imageKey, seed: pkg.slug, icon: 'mountain', label: pkg.destination, alt: `${pkg.title} — tour package from Bangalore`, cls: 'w-full h-full', eager: true }) %>
      </div>

      <div class="mt-8">
        <h2 class="font-display font-bold text-xl text-ink-900 mb-3">Overview</h2>
        <p class="text-[15px] text-ink-600 leading-relaxed"><%= pkg.description %></p>
      </div>

      <% if (highlights.length) { %>
      <div class="mt-8">
        <h2 class="font-display font-bold text-xl text-ink-900 mb-4">Trip Highlights</h2>
        <ul class="grid sm:grid-cols-2 gap-3">
          <% highlights.forEach(function(h) { %>
          <li class="flex items-start gap-2.5 text-sm text-ink-700 bg-ink-50/70 rounded-lg px-3.5 py-3">
            <%- include('../partials/icon', { name: 'check-circle', cls: 'w-4 h-4 text-brand-500 mt-0.5 shrink-0' }) %><span><%= h %></span>
          </li>
          <% }); %>
        </ul>
      </div>
      <% } %>

      <% if (vehicleOptions.length) { %>
      <div class="mt-8">
        <h2 class="font-display font-bold text-xl text-ink-900 mb-4">Suggested Vehicles</h2>
        <div class="flex flex-wrap gap-2.5">
          <% vehicleOptions.forEach(function(v) {
               const __match = matchVehicleByLabel(v, vehicles);
          %>
            <% if (__match) { %>
            <a href="/fleet/<%= __match.category %>/<%= __match.slug %>" class="badge badge-outline !py-2 !px-3.5 text-[13px] hover:border-brand-300 hover:text-brand-700 transition-colors">
              <%- include('../partials/icon', { name: 'car', cls: 'w-3.5 h-3.5' }) %><%= v %>
            </a>
            <% } else { %>
            <span class="badge badge-outline !py-2 !px-3.5 text-[13px]"><%- include('../partials/icon', { name: 'car', cls: 'w-3.5 h-3.5' }) %><%= v %></span>
            <% } %>
          <% }); %>
        </div>
        <p class="text-xs text-ink-400 mt-3">Vehicle choice depends on your group size — we'll confirm the best fit when you enquire.</p>
      </div>
      <% } %>
    </div>

    <div class="lg:col-span-2">
      <div class="admin-card !border-ink-100 p-6 sticky top-24">
        <h2 class="font-display font-semibold text-ink-900 mb-1">Request This Package</h2>
        <p class="text-sm text-ink-500 mb-5">Every itinerary can be adjusted — let us know your dates and group size.</p>
        <div class="space-y-2.5">
          <button type="button" class="btn btn-quote w-full" data-enquiry-trigger data-enquiry-type="package" data-enquiry-context="Tour Package: <%= pkg.title %>">
            <%- include('../partials/icon', { name: 'send', cls: 'w-4 h-4' }) %><span>Request Package</span>
          </button>
          <a href="https://wa.me/<%= whatsappDigits %>?text=<%= encodeURIComponent('Hi, I would like to enquire about the ' + pkg.title + ' package.') %>" target="_blank" rel="noopener" class="btn btn-outline w-full">
            <%- include('../partials/icon', { name: 'whatsapp', cls: 'w-4 h-4' }) %><span>WhatsApp Us</span>
          </a>
          <a href="<%= telHref %>" class="btn btn-ghost w-full"><%- include('../partials/icon', { name: 'phone', cls: 'w-4 h-4' }) %><span>Or Call <%= business.phone %></span></a>
        </div>

        <dl class="mt-6 pt-6 border-t border-ink-100 space-y-3 text-sm">
          <div class="flex justify-between"><dt class="text-ink-500">Destination</dt><dd class="font-medium text-ink-900"><%= pkg.destination %></dd></div>
          <div class="flex justify-between"><dt class="text-ink-500">Duration</dt><dd class="font-medium text-ink-900"><%= pkg.duration %></dd></div>
          <div class="flex justify-between"><dt class="text-ink-500">Start Location</dt><dd class="font-medium text-ink-900"><%= pkg.startLocation %></dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>

<% if (related.length) { %>
<section class="py-16 lg:py-20 bg-ink-50/60">
  <div class="container">
    <%- include('../components/section-heading', { eyebrow: 'More Ideas', heading: 'You Might Also Like' }) %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6 mt-8">
      <% related.forEach(function(p) { %>
        <%- include('../components/package-card', { pkg: p }) %>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<%- include('../partials/cta-section') %>
<%- include('../partials/page-end') %>
