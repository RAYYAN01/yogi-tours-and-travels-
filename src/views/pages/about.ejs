<%- include('../partials/page-start') %>
<%- include('../partials/breadcrumbs') %>

<section class="py-14 lg:py-20">
  <div class="container">
    <div class="max-w-2xl">
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-[0.14em] uppercase text-brand-600 mb-3">
        <span class="w-6 h-px bg-brand-500"></span>About Us
      </span>
      <h1 class="font-display font-bold text-3xl sm:text-4xl text-ink-900 tracking-tight leading-tight">Bangalore's Tours &amp; Travels Partner for Every Kind of Trip</h1>
      <p class="text-ink-500 text-[15px] sm:text-base leading-relaxed mt-4">
        Yogi Tours &amp; Travels was built to remove the usual friction of booking a vehicle — vague pricing, unclear vehicle condition, and drivers unfamiliar with the route. We focus on getting those basics right, consistently.
      </p>
      <p class="text-ink-500 text-[15px] sm:text-base leading-relaxed mt-4">
        We're based in Bengaluru — India's Silicon City, home to the IT campuses along Whitefield, Electronic City and the Outer Ring Road — so daily corporate pickups and drops are second nature to us. From inside the city to towns within roughly 150 km around Bangalore, and further out on named outstation routes like Mysore, Coorg and Goa, we cover the trip.
      </p>
      <p class="text-ink-400 text-sm leading-relaxed mt-4" lang="kn">
        ಬೆಂಗಳೂರಿನಲ್ಲಿ ಕಾರು ಬಾಡಿಗೆ, ಟೆಂಪೋ ಟ್ರಾವೆಲರ್ ಬಾಡಿಗೆ, ಇನ್ನೋವಾ ಮತ್ತು ಇನ್ನೋವಾ ಕ್ರಿಸ್ಟಾ ಬಾಡಿಗೆ, ಅರ್ಬಾನಿಯಾ ಮತ್ತು ಬಸ್ ಬಾಡಿಗೆ ಸೇವೆ ಒದಗಿಸುತ್ತೇವೆ. ಬೆಂಗಳೂರಿನಿಂದ ಔಟ್‌ಸ್ಟೇಷನ್ ಕ್ಯಾಬ್ ಮತ್ತು ಬೆಂಗಳೂರು ಏರ್‌ಪೋರ್ಟ್ ಟ್ಯಾಕ್ಸಿ ಸೇವೆಯೂ ಲಭ್ಯವಿದೆ.
      </p>
    </div>
  </div>
</section>

<section class="pb-16 lg:pb-24">
  <div class="container grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
    <div class="rounded-2xl overflow-hidden shadow-card aspect-[4/3]">
      <%- include('../components/smart-image', { src: '', seed: 'about-story', icon: 'route', label: 'Our Story', alt: 'Yogi Tours & Travels team and fleet', cls: 'w-full h-full' }) %>
    </div>
    <div>
      <h2 class="font-display font-bold text-2xl text-ink-900">How We Work</h2>
      <p class="text-[15px] text-ink-600 leading-relaxed mt-4">
        Every enquiry starts with three questions: where are you going, how many people are travelling, and how much luggage are you carrying? The answers point to a vehicle category — sedan, MUV, Tempo Traveller, mini bus or tourist bus — and from there we share a clear, itemised quotation before anything is confirmed.
      </p>
      <p class="text-[15px] text-ink-600 leading-relaxed mt-4">
        We work with families planning weekend hill-station trips, corporates coordinating offsites and airport pickups, wedding families arranging guest transportation, and schools organising educational tours. The common thread is the same: a vehicle that fits, a driver who knows the route, and a price you saw before you booked.
      </p>
      <div class="grid sm:grid-cols-2 gap-4 mt-8">
        <% [
          ["route", "Bangalore & Karnataka Expertise", "Familiar with city routes, highways and hill roads across the region."],
          ["users-group", "Family & Corporate Ready", "Vehicles and drivers suited to both leisure and business travel."],
          ["plane", "Airport Transfer Specialists", "Flight-time aware pickups and drops to Kempegowda International Airport."],
          ["sliders", "Fully Customisable Tours", "Every package can be adjusted to your dates, stops and vehicle preference."]
        ].forEach(function(item) { %>
        <div class="flex items-start gap-3 p-4 rounded-xl bg-ink-50/70">
          <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-white text-brand-600 shrink-0 shadow-sm"><%- include('../partials/icon', { name: item[0], cls: 'w-[1.125rem] h-[1.125rem]' }) %></span>
          <div>
            <p class="text-sm font-semibold text-ink-900"><%= item[1] %></p>
            <p class="text-xs text-ink-500 mt-1 leading-relaxed"><%= item[2] %></p>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>
</section>

<section class="py-16 lg:py-24 bg-ink-50/60">
  <div class="container">
    <%- include('../components/section-heading', {
      eyebrow: 'Our Coverage',
      heading: 'Areas We Serve Across Bangalore',
      sub: 'Pickups and drops across the city, with outstation routes covering Karnataka and neighbouring states.',
      align: 'center'
    }) %>
    <div class="flex flex-wrap justify-center gap-2.5 mt-8 max-w-3xl mx-auto">
      <% business.areaServed.forEach(function(area) { %>
        <span class="badge badge-outline !py-2 !px-3.5 text-[13px]"><%- include('../partials/icon', { name: 'map-pin', cls: 'w-3.5 h-3.5' }) %><%= area %></span>
      <% }); %>
    </div>
  </div>
</section>

<section id="testimonials" class="py-16 lg:py-24">
  <div class="container">
    <%- include('../components/section-heading', {
      eyebrow: 'Testimonials',
      heading: 'What Travellers Say',
      align: 'center'
    }) %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-10">
      <% testimonials.slice(0, 6).forEach(function(t) { %>
        <%- include('../components/testimonial-card', { testimonial: t }) %>
      <% }); %>
    </div>
    <% if (business.googleBusinessProfile) { %>
    <p class="text-center text-sm text-ink-500 mt-6">
      Have you travelled with us? We'd love to hear about it —
      <a href="<%= business.googleBusinessProfile %>" target="_blank" rel="noopener" class="text-brand-700 font-semibold hover:text-brand-800">leave us a review on Google</a>.
    </p>
    <% } %>
  </div>
</section>

<%- include('../partials/cta-section') %>
<%- include('../partials/page-end') %>
