<%- include('../partials/page-start') %>
<%- include('../partials/breadcrumbs') %>

<section class="py-14 lg:py-20">
  <div class="container">
    <div class="max-w-2xl mx-auto text-center">
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-[0.14em] uppercase text-brand-600 mb-3">
        <span class="w-6 h-px bg-brand-500"></span>Contact Us
      </span>
      <h1 class="font-display font-bold text-3xl sm:text-4xl text-ink-900 tracking-tight">Let's Plan Your Trip</h1>
      <p class="text-ink-500 text-[15px] sm:text-base leading-relaxed mt-4">
        Call, WhatsApp or send an enquiry below — we typically respond within a few hours during business time.
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-4 max-w-3xl mx-auto mt-10">
      <a href="<%= telHref %>" class="admin-card !border-ink-100 p-5 text-center hover:shadow-card-hover transition-shadow">
        <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-brand-50 text-brand-600 mx-auto mb-3"><%- include('../partials/icon', { name: 'phone', cls: 'w-5 h-5' }) %></span>
        <p class="text-sm font-semibold text-ink-900">Call Us</p>
        <p class="text-xs text-ink-500 mt-1"><%= business.phone %></p>
      </a>
      <a href="https://wa.me/<%= whatsappDigits %>" target="_blank" rel="noopener" class="admin-card !border-ink-100 p-5 text-center hover:shadow-card-hover transition-shadow">
        <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-[#25D366]/10 text-[#128C53] mx-auto mb-3"><%- include('../partials/icon', { name: 'whatsapp', cls: 'w-5 h-5' }) %></span>
        <p class="text-sm font-semibold text-ink-900">WhatsApp</p>
        <p class="text-xs text-ink-500 mt-1"><%= business.whatsapp %></p>
      </a>
      <a href="<%= mailtoHref %>" class="admin-card !border-ink-100 p-5 text-center hover:shadow-card-hover transition-shadow">
        <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-brand-50 text-brand-600 mx-auto mb-3"><%- include('../partials/icon', { name: 'mail', cls: 'w-5 h-5' }) %></span>
        <p class="text-sm font-semibold text-ink-900">Email</p>
        <p class="text-xs text-ink-500 mt-1 break-all"><%= business.email %></p>
      </a>
    </div>
  </div>
</section>

<section class="pb-16 lg:pb-24">
  <div class="container grid lg:grid-cols-5 gap-8 lg:gap-10">
    <div class="lg:col-span-3 admin-card !border-ink-100 p-6 sm:p-8" data-enquiry-root>
      <h2 class="font-display font-bold text-xl text-ink-900 mb-1">Send an Enquiry</h2>
      <p class="text-sm text-ink-500 mb-6">Fill in the details below — we'll open WhatsApp with your message ready to send.</p>

      <form id="contact-form" data-enquiry-form data-form-state="idle" novalidate>
        <input type="hidden" name="type" value="contact" />
        <input type="hidden" name="sourcePage" value="/contact" />
        <div class="hidden" aria-hidden="true">
          <label for="contact-website">Leave blank</label>
          <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="contact-name" class="form-label">Full Name <span class="text-error">*</span></label>
            <input type="text" id="contact-name" name="name" class="form-input" autocomplete="name" required />
            <p class="form-error" data-error-for="name"></p>
          </div>
          <div>
            <label for="contact-phone" class="form-label">Phone Number <span class="text-error">*</span></label>
            <input type="tel" id="contact-phone" name="phone" class="form-input" autocomplete="tel" required />
            <p class="form-error" data-error-for="phone"></p>
          </div>
          <div class="sm:col-span-2">
            <label for="contact-email" class="form-label">Email <span class="text-ink-400 font-normal">(optional)</span></label>
            <input type="email" id="contact-email" name="email" class="form-input" autocomplete="email" />
            <p class="form-error" data-error-for="email"></p>
          </div>
          <div class="sm:col-span-2">
            <label for="contact-message" class="form-label">Your Message <span class="text-error">*</span></label>
            <textarea id="contact-message" name="message" rows="4" class="form-input resize-none" required></textarea>
            <p class="form-error" data-error-for="message"></p>
          </div>
        </div>

        <p class="form-error mt-3" data-error-for="_form"></p>

        <button type="submit" class="btn btn-primary w-full sm:w-auto mt-5" data-submit-button>
          <span data-btn-label>Send Enquiry</span>
          <%- include('../partials/icon', { name: 'loader', cls: 'w-4 h-4 ml-1 animate-spin hidden' }) %>
        </button>
      </form>

      <div data-form-state="success" class="hidden text-center py-6">
        <div class="mx-auto flex items-center justify-center w-14 h-14 rounded-full bg-success/10 text-success mb-4">
          <%- include('../partials/icon', { name: 'check-circle', cls: 'w-7 h-7' }) %>
        </div>
        <h3 class="font-display text-lg font-bold text-ink-900">Enquiry Ready to Send</h3>
        <p class="text-sm text-ink-500 mt-1.5 mb-5">Continue on WhatsApp to send your message to our team instantly.</p>
        <div class="flex flex-col sm:flex-row gap-2.5 justify-center">
          <a href="#" data-success-whatsapp target="_blank" rel="noopener" class="btn btn-primary"><%- include('../partials/icon', { name: 'whatsapp', cls: 'w-4 h-4' }) %><span>Continue on WhatsApp</span></a>
          <button type="button" class="btn btn-outline" data-form-reset>Send Another</button>
        </div>
      </div>
      <div data-form-state="error" class="hidden text-center py-6">
        <div class="mx-auto flex items-center justify-center w-14 h-14 rounded-full bg-error/10 text-error mb-4">
          <%- include('../partials/icon', { name: 'alert-circle', cls: 'w-7 h-7' }) %>
        </div>
        <h3 class="font-display text-lg font-bold text-ink-900">Couldn't Send Your Enquiry</h3>
        <p class="text-sm text-ink-500 mt-1.5 mb-5">Please try again, or reach us directly.</p>
        <button type="button" class="btn btn-primary" data-form-retry>Try Again</button>
      </div>
    </div>

    <div class="lg:col-span-2 space-y-5">
      <div class="rounded-2xl overflow-hidden aspect-[4/3] shadow-card">
        <iframe
          src="https://www.google.com/maps?q=<%= encodeURIComponent(business.addressLine) %>&output=embed"
          class="w-full h-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="<%= business.name %> location on Google Maps"
        ></iframe>
      </div>
      <div class="admin-card !border-ink-100 p-6">
        <h3 class="font-display font-semibold text-ink-900 mb-3">Business Hours</h3>
        <p class="text-sm text-ink-600 font-medium">Open 24 hours, every day</p>
        <p class="text-xs text-ink-400 mt-3">Phone &amp; WhatsApp enquiries are monitored around the clock for urgent airport and outstation bookings.</p>
      </div>
      <div class="admin-card !border-ink-100 p-6">
        <h3 class="font-display font-semibold text-ink-900 mb-3">Registered Location</h3>
        <p class="flex items-start gap-2 text-sm text-ink-600"><%- include('../partials/icon', { name: 'map-pin', cls: 'w-4 h-4 mt-0.5 text-brand-500 shrink-0' }) %><%= business.addressLine %></p>
        <a
          href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(business.addressLine) %>"
          target="_blank"
          rel="noopener"
          class="btn btn-outline btn-sm w-full mt-4"
        ><%- include('../partials/icon', { name: 'map-pin', cls: 'w-3.5 h-3.5' }) %>Get Directions</a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/page-end') %>
