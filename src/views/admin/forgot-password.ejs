<%- include('_partials/admin-head', { title: 'Forgot Password | ' + business.name }) %>
<body class="font-body text-ink-800 antialiased bg-ink-950 min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-sm">
    <div class="flex flex-col items-center mb-6">
      <img src="/assets/images/logo.png" alt="<%= business.name %>" class="h-14 w-14 rounded-full object-cover mb-3 shadow-md" />
      <h1 class="font-display font-bold text-white text-lg">Reset Your Password</h1>
      <p class="text-ink-400 text-sm mt-0.5 text-center">Enter your admin username and we'll email a reset link to the registered business email.</p>
    </div>

    <div class="admin-card bg-white p-6 sm:p-7">
      <% if (sent) { %>
      <div class="text-center py-2">
        <div class="mx-auto flex items-center justify-center w-12 h-12 rounded-full bg-success/10 text-success mb-4">
          <%- include('../partials/icon', { name: 'check-circle', cls: 'w-6 h-6' }) %>
        </div>
        <h2 class="font-display font-semibold text-ink-900">Check Your Email</h2>
        <p class="text-sm text-ink-500 mt-1.5">If that account exists, a reset link has been sent to the registered business email. The link expires in 30 minutes.</p>
      </div>
      <% } else { %>
      <form action="/admin/forgot-password" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div>
          <label for="username" class="form-label">Username</label>
          <input type="text" id="username" name="username" class="form-input" autocomplete="username" required autofocus />
        </div>
        <button type="submit" class="btn btn-primary w-full mt-6">Send Reset Link</button>
      </form>
      <% } %>
    </div>
    <p class="text-center text-ink-500 text-xs mt-5"><a href="/admin/login" class="hover:text-ink-300">&larr; Back to sign in</a></p>
  </div>
  <script type="module" src="/js/main.js"></script>
</body>
</html>
