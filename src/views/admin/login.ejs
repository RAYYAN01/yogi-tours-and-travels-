<%- include('_partials/admin-head', { title: 'Admin Login | ' + business.name }) %>
<body class="font-body text-ink-800 antialiased bg-ink-950 min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-sm">
    <div class="flex flex-col items-center mb-6">
      <img src="/assets/images/logo.png" alt="<%= business.name %>" class="h-14 w-14 rounded-full object-cover mb-3 shadow-md" />
      <h1 class="font-display font-bold text-white text-lg">Yogi Admin</h1>
      <p class="text-ink-400 text-sm mt-0.5">Sign in to manage your website</p>
    </div>

    <div class="admin-card bg-white p-6 sm:p-7">
      <% if (typeof resetSuccess !== "undefined" && resetSuccess) { %>
      <div class="mb-4 rounded-lg bg-success/10 text-success text-sm font-medium px-3.5 py-2.5 flex items-center gap-2">
        <%- include('../partials/icon', { name: 'check-circle', cls: 'w-4 h-4 shrink-0' }) %>Password updated — sign in with your new password.
      </div>
      <% } %>
      <% if (error) { %>
      <div class="mb-4 rounded-lg bg-error/10 text-error text-sm font-medium px-3.5 py-2.5 flex items-center gap-2">
        <%- include('../partials/icon', { name: 'alert-circle', cls: 'w-4 h-4 shrink-0' }) %><%= error %>
      </div>
      <% } %>
      <form action="/admin/login" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="space-y-4">
          <div>
            <label for="username" class="form-label">Username</label>
            <input type="text" id="username" name="username" class="form-input" autocomplete="username" required autofocus />
          </div>
          <%- include('../partials/password-field', { id: 'password', name: 'password', label: 'Password', autocomplete: 'current-password' }) %>
        </div>
        <button type="submit" class="btn btn-primary w-full mt-6">Sign In</button>
      </form>
      <p class="text-center text-sm mt-4"><a href="/admin/forgot-password" class="text-brand-700 hover:text-brand-800 font-medium">Forgot password?</a></p>
    </div>
    <p class="text-center text-ink-500 text-xs mt-5"><a href="/" class="hover:text-ink-300">&larr; Back to website</a></p>
  </div>
  <script type="module" src="/js/main.js"></script>
</body>
</html>
