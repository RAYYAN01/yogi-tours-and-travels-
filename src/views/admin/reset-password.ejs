<%- include('_partials/admin-head', { title: 'Reset Password | ' + business.name }) %>
<body class="font-body text-ink-800 antialiased bg-ink-950 min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-sm">
    <div class="flex flex-col items-center mb-6">
      <img src="/assets/images/logo.png" alt="<%= business.name %>" class="h-14 w-14 rounded-full object-cover mb-3 shadow-md" />
      <h1 class="font-display font-bold text-white text-lg">Set a New Password</h1>
    </div>

    <div class="admin-card bg-white p-6 sm:p-7">
      <% if (error) { %>
      <div class="mb-4 rounded-lg bg-error/10 text-error text-sm font-medium px-3.5 py-2.5 flex items-center gap-2">
        <%- include('../partials/icon', { name: 'alert-circle', cls: 'w-4 h-4 shrink-0' }) %><%= error %>
      </div>
      <% } %>

      <% if (!valid) { %>
      <p class="text-sm text-ink-500">This link is invalid or has expired. Request a new one from the sign-in page.</p>
      <% } else { %>
      <form action="/admin/reset-password/<%= token %>" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="space-y-4">
          <%- include('../partials/password-field', { id: 'password', name: 'password', label: 'New Password', autocomplete: 'new-password', minlength: 8 }) %>
          <%- include('../partials/password-field', { id: 'confirmPassword', name: 'confirmPassword', label: 'Confirm New Password', autocomplete: 'new-password', minlength: 8 }) %>
        </div>
        <button type="submit" class="btn btn-primary w-full mt-6">Update Password</button>
      </form>
      <% } %>
    </div>
    <p class="text-center text-ink-500 text-xs mt-5"><a href="/admin/login" class="hover:text-ink-300">&larr; Back to sign in</a></p>
  </div>
  <script type="module" src="/js/main.js"></script>
</body>
</html>
