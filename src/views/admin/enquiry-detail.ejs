<%- include('_partials/admin-start', { pageTitle: 'Enquiry #' + enquiry.id }) %>

<a href="/admin/enquiries" class="inline-flex items-center gap-1.5 text-sm text-ink-500 hover:text-brand-700 mb-4">
  <%- include('../partials/icon', { name: 'arrow-left', cls: 'w-4 h-4' }) %>Back to enquiries
</a>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
  <div class="lg:col-span-2 admin-card p-5 sm:p-6">
    <div class="flex items-center justify-between mb-5">
      <h2 class="font-display font-semibold text-lg text-ink-900">Enquiry Details</h2>
      <span class="badge badge-brand capitalize"><%= enquiry.type %></span>
    </div>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm">
      <div><dt class="text-ink-400 text-xs mb-1">Name</dt><dd class="font-medium text-ink-900"><%= enquiry.name %></dd></div>
      <div><dt class="text-ink-400 text-xs mb-1">Phone</dt><dd class="font-medium text-ink-900"><a href="tel:<%= enquiry.phone %>" class="hover:text-brand-700"><%= enquiry.phone %></a></dd></div>
      <% if (enquiry.email) { %><div><dt class="text-ink-400 text-xs mb-1">Email</dt><dd class="font-medium text-ink-900 break-all"><a href="mailto:<%= enquiry.email %>" class="hover:text-brand-700"><%= enquiry.email %></a></dd></div><% } %>
      <% if (enquiry.pickupLocation) { %><div><dt class="text-ink-400 text-xs mb-1">Pickup Location</dt><dd class="font-medium text-ink-900"><%= enquiry.pickupLocation %></dd></div><% } %>
      <% if (enquiry.destination) { %><div><dt class="text-ink-400 text-xs mb-1">Destination</dt><dd class="font-medium text-ink-900"><%= enquiry.destination %></dd></div><% } %>
      <% if (enquiry.tripType) { %><div><dt class="text-ink-400 text-xs mb-1">Trip Type</dt><dd class="font-medium text-ink-900"><%= enquiry.tripType %></dd></div><% } %>
      <% if (enquiry.pickupDate) { %><div><dt class="text-ink-400 text-xs mb-1">Date</dt><dd class="font-medium text-ink-900"><%= enquiry.pickupDate %></dd></div><% } %>
      <% if (enquiry.returnDate) { %><div><dt class="text-ink-400 text-xs mb-1">Return Date</dt><dd class="font-medium text-ink-900"><%= enquiry.returnDate %></dd></div><% } %>
      <% if (enquiry.vehicleType) { %><div><dt class="text-ink-400 text-xs mb-1">Vehicle Type</dt><dd class="font-medium text-ink-900"><%= enquiry.vehicleType %></dd></div><% } %>
      <% if (enquiry.passengers) { %><div><dt class="text-ink-400 text-xs mb-1">Passengers</dt><dd class="font-medium text-ink-900"><%= enquiry.passengers %></dd></div><% } %>
    </dl>
    <% if (enquiry.message) { %>
    <div class="mt-5 pt-5 border-t border-ink-100">
      <dt class="text-ink-400 text-xs mb-1.5">Message</dt>
      <dd class="text-ink-700 text-sm leading-relaxed"><%= enquiry.message %></dd>
    </div>
    <% } %>
    <div class="mt-5 pt-5 border-t border-ink-100 text-xs text-ink-400 space-y-1">
      <p>Submitted: <%= enquiry.createdAt %></p>
      <% if (enquiry.sourcePage) { %><p>Source page: <%= enquiry.sourcePage %></p><% } %>
    </div>
  </div>

  <div class="admin-card p-5 sm:p-6 h-fit">
    <h2 class="font-display font-semibold text-ink-900 mb-4">Actions</h2>
    <div class="flex flex-col gap-2.5 mb-5">
      <a href="tel:<%= enquiry.phone %>" class="btn btn-outline w-full"><%- include('../partials/icon', { name: 'phone', cls: 'w-4 h-4' }) %>Call <%= enquiry.name %></a>
      <a href="https://wa.me/<%= enquiry.phone.replace(/[^\d]/g, '') %>" target="_blank" rel="noopener" class="btn btn-primary w-full"><%- include('../partials/icon', { name: 'whatsapp', cls: 'w-4 h-4' }) %>WhatsApp <%= enquiry.name %></a>
    </div>
    <form action="/admin/enquiries/<%= enquiry.id %>/status" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label for="status" class="form-label">Status</label>
      <select id="status" name="status" class="form-input mb-3">
        <% ["new", "contacted", "closed"].forEach(function(s) { %>
          <option value="<%= s %>" <%= enquiry.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
        <% }); %>
      </select>
      <button type="submit" class="btn btn-outline w-full">Update Status</button>
    </form>
  </div>
</div>

<%- include('_partials/admin-end') %>
