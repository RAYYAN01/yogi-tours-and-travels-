<%
const __t = testimonial;
%>
<figure class="flex flex-col h-full bg-white rounded-2xl border border-ink-100 shadow-card p-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-0.5 text-sun-400" aria-hidden="true">
      <% for (let i = 0; i < 5; i++) { %>
        <%- include('../partials/icon', { name: 'star', cls: `w-4 h-4 ${i < __t.rating ? 'text-sun-400' : 'text-ink-200'}` }) %>
      <% } %>
    </div>
    <span class="sr-only"><%= __t.rating %> out of 5 stars</span>
    <%- include('../partials/icon', { name: 'quote', cls: 'w-6 h-6 text-brand-100' }) %>
  </div>

  <blockquote class="text-[15px] text-ink-700 leading-relaxed mt-4 flex-1">&ldquo;<%= __t.review %>&rdquo;</blockquote>

  <figcaption class="mt-5 pt-4 border-t border-ink-100">
    <div class="flex items-center gap-3">
      <span class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-100 text-brand-700 font-display font-semibold text-sm shrink-0">
        <%= __t.name.charAt(0) %>
      </span>
      <div>
        <p class="font-semibold text-ink-900 text-sm"><%= __t.name %></p>
        <p class="text-xs text-ink-500"><%= __t.tripType %></p>
      </div>
    </div>
    <% if (__t.isPlaceholder) { %>
    <p class="mt-3 inline-flex items-center gap-1 text-[11px] font-medium text-ink-400 bg-ink-50 rounded-full px-2.5 py-1">
      <%- include('../partials/icon', { name: 'info', cls: 'w-3 h-3' }) %>Sample review — awaiting verified customer feedback
    </p>
    <% } %>
  </figcaption>
</figure>
