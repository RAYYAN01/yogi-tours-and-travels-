<%
const __s = service;
const __detailUrl = `/services/${__s.slug}`;
%>
<article class="card-service group flex flex-col h-full bg-white rounded-2xl border border-ink-100 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-300">
  <a href="<%= __detailUrl %>" class="relative block aspect-[4/3] overflow-hidden rounded-t-2xl">
    <%- include('smart-image', {
      src: __s.imageKey, seed: __s.slug, icon: __s.icon, label: __s.name,
      alt: `${__s.name} in Bangalore — Yogi Tours & Travels`,
      cls: 'w-full h-full group-hover:scale-[1.04] transition-transform duration-500'
    }) %>
    <span class="absolute top-3 left-3 flex items-center justify-center w-9 h-9 rounded-lg bg-white/90 backdrop-blur text-brand-600 shadow-sm">
      <%- include('../partials/icon', { name: __s.icon, cls: 'w-4 h-4' }) %>
    </span>
  </a>

  <div class="relative p-6 flex flex-col flex-1">
    <h3 class="font-display font-semibold text-[17px] text-ink-900">
      <a href="<%= __detailUrl %>" class="hover:text-brand-700 transition-colors after:absolute after:inset-0"><%= __s.name %></a>
    </h3>
    <p class="text-sm text-ink-500 mt-2 leading-relaxed flex-1"><%= __s.shortDescription %></p>
    <div class="flex items-center justify-between mt-5 pt-4 border-t border-ink-100">
      <a href="<%= __detailUrl %>" class="relative z-10 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800 transition-colors">
        Learn More <%- include('../partials/icon', { name: 'arrow-right', cls: 'w-3.5 h-3.5' }) %>
      </a>
      <button type="button" class="btn btn-quote btn-sm relative z-10" data-enquiry-trigger data-enquiry-type="quote" data-enquiry-context="Service: <%= __s.name %>">
        Get Quote
      </button>
    </div>
  </div>
</article>
