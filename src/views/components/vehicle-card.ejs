<%
/* Locals: vehicle (row), showCategory (bool, default true) */
const __v = vehicle;
const __showCategory = typeof showCategory !== "undefined" ? showCategory : true;
const __features = parseJsonArray(__v.features);
const __detailUrl = `/fleet/${__v.category}/${__v.slug}`;
const __fullStars = __v.rating ? Math.floor(__v.rating) : 0;
const __halfStar = __v.rating ? __v.rating - __fullStars >= 0.5 : false;
const __tariff = dutyTariff(__v.slug);
%>
<article class="card-vehicle group flex flex-col h-full bg-white rounded-2xl border border-ink-100 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-300">
  <a href="<%= __detailUrl %>" class="relative block aspect-[4/3] overflow-hidden rounded-t-2xl">
    <%- include('smart-image', {
      src: __v.imageKey, seed: __v.slug, icon: vehicleCategoryIcon(__v.category), label: __v.name,
      alt: `${__v.name} rental in Bangalore — ${__v.seats} seater`,
      cls: 'w-full h-full group-hover:scale-[1.04] transition-transform duration-500'
    }) %>
    <% if (__showCategory) { %>
    <span class="absolute top-3 left-3 badge badge-dark"><%= vehicleCategoryLabels[__v.category] %></span>
    <% } %>
    <% if (__v.ac) { %>
    <span class="absolute top-3 right-3 badge badge-light"><%- include('../partials/icon', { name: 'snowflake', cls: 'w-3 h-3' }) %>AC</span>
    <% } %>
    <% if (__v.ratePerKm) { %>
    <span class="absolute bottom-3 left-3 badge bg-sun-600 text-ink-900 shadow-sm">₹<%= __v.ratePerKm %>/km onwards</span>
    <% } else { %>
    <span class="absolute bottom-3 left-3 badge bg-ink-900/85 text-white shadow-sm">Price on Request</span>
    <% } %>
  </a>

  <div class="p-5 flex flex-col flex-1">
    <h3 class="font-display font-semibold text-[17px] text-ink-900 leading-snug">
      <a href="<%= __detailUrl %>" class="hover:text-brand-700 transition-colors"><%= __v.name %></a>
    </h3>
    <% if (__v.rating || __v.vehicleClass) { %>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2">
      <% if (__v.rating) { %>
      <span class="inline-flex items-center gap-1 bg-ink-900 text-white rounded-md px-2 py-1 text-[12px] font-semibold" title="Our own vehicle condition rating, not a customer review score">
        <span class="flex items-center gap-0.5" aria-hidden="true">
          <% for (let i = 0; i < 5; i++) {
               const filled = i < __fullStars;
               const half = !filled && i === __fullStars && __halfStar;
          %>
            <%- include('../partials/icon', { name: 'star', cls: `w-3 h-3 ${filled ? 'text-sun-400' : half ? 'text-sun-400/50' : 'text-white/30'}` }) %>
          <% } %>
        </span>
        <span><%= __v.rating.toFixed(1) %><% if (__v.vehicleClass) { %> - <%= __v.vehicleClass %><% } %></span>
      </span>
      <% } else if (__v.vehicleClass) { %>
      <span class="badge badge-outline"><%= __v.vehicleClass %></span>
      <% } %>
      <span class="flex items-center gap-1 text-[13px] text-ink-500"><%- include('../partials/icon', { name: 'users', cls: 'w-3.5 h-3.5' }) %><%= __v.seats %> Passengers</span>
    </div>
    <% } %>

    <p class="text-sm text-ink-500 mt-1.5 leading-relaxed line-clamp-2"><%= __v.tagline %></p>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 mt-3.5 text-[13px] text-ink-600">
      <span class="flex items-center gap-1.5"><%- include('../partials/icon', { name: 'users', cls: 'w-3.5 h-3.5 text-brand-500' }) %><%= seatLabel(__v) %></span>
      <span class="flex items-center gap-1.5"><%- include('../partials/icon', { name: 'luggage', cls: 'w-3.5 h-3.5 text-brand-500' }) %><%= __v.luggage %></span>
    </div>

    <% if (__tariff) { %>
    <p class="flex items-center gap-1.5 text-[12px] text-ink-500 mt-2">
      <%- include('../partials/icon', { name: 'info', cls: 'w-3.5 h-3.5 text-brand-500 shrink-0' }) %>
      Min <%= __tariff.minKmPerDay %> km/day · Bata ₹<%= __tariff.driverBata %>/day
    </p>
    <% } %>

    <% if (__features.length) { %>
    <div class="flex flex-wrap gap-1.5 mt-3.5">
      <% __features.slice(0, 3).forEach(function(f) { %>
        <span class="badge badge-outline"><%= f %></span>
      <% }); %>
      <% if (__features.length > 3) { %><span class="badge badge-outline">+<%= __features.length - 3 %> more</span><% } %>
    </div>
    <% } %>

    <div class="mt-auto pt-5 flex gap-2">
      <a href="<%= __detailUrl %>" class="btn btn-outline btn-sm flex-1">
        <%- include('../partials/icon', { name: 'eye', cls: 'w-3.5 h-3.5' }) %>View More
      </a>
      <a
        href="https://wa.me/<%= whatsappDigits %>?text=<%= encodeURIComponent('Hi, I would like to enquire about the ' + __v.name + '.') %>"
        target="_blank"
        rel="noopener"
        class="shine flex items-center justify-center w-11 h-11 rounded-lg bg-[#25D366] text-white hover:bg-[#1ebe5a] transition-colors shrink-0"
        aria-label="Ask about <%= __v.name %> on WhatsApp"
      ><%- include('../partials/icon', { name: 'whatsapp', cls: 'w-4 h-4' }) %></a>
      <a
        href="<%= telHref %>"
        class="shine flex items-center justify-center w-11 h-11 rounded-lg bg-brand-500 text-white hover:bg-brand-600 transition-colors shrink-0"
        aria-label="Call about <%= __v.name %>"
      ><%- include('../partials/icon', { name: 'phone', cls: 'w-4 h-4' }) %></a>
    </div>
  </div>
</article>
