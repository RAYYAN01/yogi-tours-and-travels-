<div id="booking-widget" class="relative bg-white/10 backdrop-blur-2xl backdrop-saturate-150 rounded-2xl shadow-glass border border-white/20 max-w-3xl w-full" data-enquiry-root>
 <div data-form-state="idle">
  <div class="px-4 pt-4 sm:px-5 sm:pt-5">
    <h2 class="font-display text-lg font-bold text-white">Get a Free Quote</h2>
    <p class="text-sm text-white/70 mt-0.5">Tell us your vehicle and travel dates — we'll reply with a price.</p>
  </div>

  <form id="booking-form" class="p-4 sm:p-5" data-enquiry-form novalidate>
    <input type="hidden" name="type" value="quote" />
    <input type="hidden" name="sourcePage" value="" />

    <%- include('enquiry-fields', { idPrefix: 'booking' }) %>

    <p class="form-error mt-3" data-error-for="_form"></p>
    <button type="submit" class="btn btn-accent w-full sm:w-auto mt-5" data-submit-button>
      <span data-btn-label>Get a Quote</span>
      <%- include('icon', { name: 'loader', cls: 'w-4 h-4 ml-1 animate-spin hidden' }) %>
    </button>
  </form>
 </div>

  <!-- Shared success/error states for the booking widget -->
  <div data-form-state="success" class="hidden text-center p-8">
    <div class="mx-auto flex items-center justify-center w-14 h-14 rounded-full bg-success/10 text-success mb-4">
      <%- include('icon', { name: 'check-circle', cls: 'w-7 h-7' }) %>
    </div>
    <h3 class="font-display text-lg font-bold text-ink-900">Your Enquiry Is Ready</h3>
    <p class="text-sm text-ink-500 mt-1.5 mb-5">We've saved your request. Continue on WhatsApp to send it to our team instantly.</p>
    <div class="flex flex-col sm:flex-row gap-2.5 justify-center">
      <a href="#" data-success-whatsapp target="_blank" rel="noopener" class="btn btn-primary">
        <%- include('icon', { name: 'whatsapp', cls: 'w-4 h-4' }) %><span>Continue on WhatsApp</span>
      </a>
      <button type="button" class="btn btn-outline" data-form-reset>Make Another Enquiry</button>
    </div>
  </div>
  <div data-form-state="error" class="hidden text-center p-8">
    <div class="mx-auto flex items-center justify-center w-14 h-14 rounded-full bg-error/10 text-error mb-4">
      <%- include('icon', { name: 'alert-circle', cls: 'w-7 h-7' }) %>
    </div>
    <h3 class="font-display text-lg font-bold text-ink-900">Couldn't Submit Your Enquiry</h3>
    <p class="text-sm text-ink-500 mt-1.5 mb-5">Please try again, or reach us directly and we'll help right away.</p>
    <div class="flex flex-col sm:flex-row gap-2.5 justify-center">
      <button type="button" class="btn btn-primary" data-form-retry>Try Again</button>
      <a href="<%= telHref %>" class="btn btn-outline"><%- include('icon', { name: 'phone', cls: 'w-4 h-4' }) %><span>Call Us</span></a>
    </div>
  </div>
</div>
