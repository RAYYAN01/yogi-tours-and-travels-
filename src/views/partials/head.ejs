<%
const __title = typeof title !== "undefined" ? title : `${business.name} — Car, Tempo Traveller & Bus Rental in Bangalore`;
const __desc = typeof metaDescription !== "undefined" ? metaDescription : business.description;
const __canonical = typeof canonicalPath !== "undefined" ? `${env.siteUrl}${canonicalPath}` : canonicalUrl;
const __hasCustomOgImage = typeof ogImage !== "undefined";
const __ogImage = __hasCustomOgImage ? ogImage : `${env.siteUrl}/assets/images/og-default.png`;
const __noindex = typeof noindex !== "undefined" ? noindex : false;
const __schemas = typeof schemas !== "undefined" ? schemas : [];
// Google itself has ignored the keywords meta tag since ~2009, but it's a
// harmless, real reflection of the page's actual topic and some SEO audit
// tools/other search engines still check for it. Page routes can pass a
// more specific metaKeywords string; this is the sitewide fallback.
const __keywords = typeof metaKeywords !== "undefined" ? metaKeywords :
  "tours and travels bangalore, car rental bangalore, tempo traveller rental bangalore, cab service bangalore, outstation cabs bangalore, airport taxi bangalore, mini bus rental bangalore, tourist bus rental bangalore, innova crysta rental bangalore";
%><!doctype html>
<html lang="en-IN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <script>document.documentElement.classList.add('js');</script>
  <title><%= __title %></title>
  <meta name="description" content="<%= __desc %>" />
  <meta name="keywords" content="<%= __keywords %>" />
  <meta name="publisher" content="<%= business.name %>" />
  <meta name="author" content="<%= business.name %>" />
  <link rel="canonical" href="<%= __canonical %>" />
  <% if (env.googleSiteVerification) { %>
  <meta name="google-site-verification" content="<%= env.googleSiteVerification %>" />
  <% } %>
  <% if (__noindex) { %>
  <meta name="robots" content="noindex, nofollow" />
  <% } else { %>
  <meta name="robots" content="index, follow" />
  <% } %>

  <!-- Geo tags — legacy but still read by some local directories/crawlers -->
  <meta name="geo.region" content="IN-KA" />
  <meta name="geo.placename" content="Bengaluru" />
  <meta name="ICBM" content="<%= business.geo.latitude %>, <%= business.geo.longitude %>" />
  <meta name="geo.position" content="<%= business.geo.latitude %>;<%= business.geo.longitude %>" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="<%= business.name %>" />
  <meta property="og:title" content="<%= __title %>" />
  <meta property="og:description" content="<%= __desc %>" />
  <meta property="og:url" content="<%= __canonical %>" />
  <meta property="og:image" content="<%= __ogImage %>" />
  <% if (!__hasCustomOgImage) { %>
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <% } %>
  <meta property="og:locale" content="en_IN" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= __title %>" />
  <meta name="twitter:description" content="<%= __desc %>" />
  <meta name="twitter:image" content="<%= __ogImage %>" />

  <link rel="icon" href="/assets/images/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/assets/images/favicon-512.png" sizes="512x512" type="image/png" />
  <link rel="apple-touch-icon" href="/assets/images/favicon-180.png" />
  <!-- Brand colour (Tailwind brand-600) for the Chrome/Android address bar and Safari tab colour -->
  <meta name="theme-color" content="#942106" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" /></noscript>

  <link rel="stylesheet" href="/css/main.css" />

  <script type="application/ld+json"><%- JSON.stringify(organizationSchema) %></script>
  <% __schemas.forEach(function (s) { %>
  <script type="application/ld+json"><%- JSON.stringify(s) %></script>
  <% }); %>

  <% if (env.gaMeasurementId) { %>
  <!-- Google Analytics is NOT loaded here. cookieConsent.ts injects it only
       after the visitor accepts analytics cookies in the consent banner. -->
  <script>window.__gaMeasurementId = "<%= env.gaMeasurementId %>";</script>
  <% } %>
</head>
