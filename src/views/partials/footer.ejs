<footer class="bg-ink-950 text-ink-300">
  <div class="container py-14 lg:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
      <div class="lg:col-span-4">
        <div class="mb-4">
          <%- include('logo') %>
        </div>
        <p class="text-sm leading-relaxed text-ink-400 max-w-sm">
          A Bangalore-based tours and travels agency offering car rentals, Tempo Traveller and mini bus hire, tourist bus rental, airport transfers and customised tour packages across Karnataka and South India.
        </p>
        <div class="flex items-center gap-2.5 mt-5">
          <% [["facebook", business.social.facebook], ["instagram", business.social.instagram], ["youtube", business.social.youtube], ["twitter", business.social.twitter]].forEach(function(s) { %>
            <a href="<%= s[1] || '#' %>" class="flex items-center justify-center w-9 h-9 rounded-lg bg-white/5 text-ink-300 hover:bg-brand-600 hover:text-white transition-colors" aria-label="<%= s[0] %>" <%= s[1] ? '' : 'aria-disabled="true"' %>>
              <%- include('icon', { name: s[0], cls: 'w-4 h-4' }) %>
            </a>
          <% }); %>
        </div>
      </div>

      <nav class="lg:col-span-2" aria-label="Company">
        <h3 class="font-display font-semibold text-white text-sm tracking-wide uppercase mb-4">Company</h3>
        <ul class="space-y-2.5 text-sm">
          <% footerCompanyLinks.forEach(function(l) { %>
            <li><a href="<%= l.href %>" class="hover:text-white transition-colors"><%= l.label %></a></li>
          <% }); %>
        </ul>
      </nav>

      <nav class="lg:col-span-2" aria-label="Services">
        <h3 class="font-display font-semibold text-white text-sm tracking-wide uppercase mb-4">Services</h3>
        <ul class="space-y-2.5 text-sm">
          <% footerServiceLinks.forEach(function(l) { %>
            <li><a href="<%= l.href %>" class="hover:text-white transition-colors"><%= l.label %></a></li>
          <% }); %>
        </ul>
      </nav>

      <nav class="lg:col-span-2" aria-label="Tours">
        <h3 class="font-display font-semibold text-white text-sm tracking-wide uppercase mb-4">Tours</h3>
        <ul class="space-y-2.5 text-sm">
          <% footerToursLinks.forEach(function(l) { %>
            <li><a href="<%= l.href %>" class="hover:text-white transition-colors"><%= l.label %></a></li>
          <% }); %>
        </ul>
      </nav>

      <div class="lg:col-span-2" aria-label="Contact">
        <h3 class="font-display font-semibold text-white text-sm tracking-wide uppercase mb-4">Contact</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="<%= telHref %>" class="flex items-start gap-2.5 hover:text-white transition-colors"><%- include('icon', { name: 'phone', cls: 'w-4 h-4 mt-0.5 shrink-0 text-brand-400' }) %><span><%= business.phone %></span></a></li>
          <li><a href="https://wa.me/<%= whatsappDigits %>" target="_blank" rel="noopener" class="flex items-start gap-2.5 hover:text-white transition-colors"><%- include('icon', { name: 'whatsapp', cls: 'w-4 h-4 mt-0.5 shrink-0 text-brand-400' }) %><span><%= business.whatsapp %></span></a></li>
          <li><a href="<%= mailtoHref %>" class="flex items-start gap-2.5 hover:text-white transition-colors"><%- include('icon', { name: 'mail', cls: 'w-4 h-4 mt-0.5 shrink-0 text-brand-400' }) %><span class="break-all"><%= business.email %></span></a></li>
          <li class="flex items-start gap-2.5"><%- include('icon', { name: 'map-pin', cls: 'w-4 h-4 mt-0.5 shrink-0 text-brand-400' }) %><span><%= business.addressLine %></span></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-ink-500">
      <p>&copy; <%= new Date().getFullYear() %> <%= business.name %>. All rights reserved.</p>
      <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1.5">
        <% legalLinks.forEach(function(l) { %>
          <li><a href="<%= l.href %>" class="hover:text-ink-200 transition-colors"><%= l.label %></a></li>
        <% }); %>
      </ul>
    </div>
  </div>
</footer>
