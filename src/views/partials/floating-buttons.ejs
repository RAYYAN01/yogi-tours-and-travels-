<!-- Floating WhatsApp button: sits above the mobile sticky bar, lower on desktop where there is no bar -->
<a
  href="https://wa.me/<%= whatsappDigits %>?text=<%= encodeURIComponent('Hi ' + business.name + ', I would like to enquire about a booking.') %>"
  target="_blank"
  rel="noopener"
  class="shine fixed z-40 right-4 bottom-[calc(5rem+env(safe-area-inset-bottom))] lg:right-6 lg:bottom-6 flex items-center justify-center w-14 h-14 rounded-full bg-[#25D366] text-white shadow-popover hover:scale-105 active:scale-95 transition-transform"
  aria-label="Chat with us on WhatsApp"
>
  <%- include('icon', { name: 'whatsapp', cls: 'w-7 h-7' }) %>
</a>

<!-- Mobile sticky CTA bar -->
<div
  class="fixed inset-x-0 bottom-0 z-30 lg:hidden bg-white border-t border-ink-100 shadow-[0_-4px_16px_rgba(11,16,23,0.08)]"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="grid grid-cols-5 h-16">
    <a href="/" class="shine shine-dark flex flex-col items-center justify-center gap-0.5 text-ink-600 active:bg-ink-50" aria-label="<%= business.name %> — Home">
      <%- include('icon', { name: 'home', cls: 'w-5 h-5' }) %>
      <span class="text-[11px] font-medium">Home</span>
    </a>
    <a href="/fleet" class="shine shine-dark flex flex-col items-center justify-center gap-0.5 text-ink-600 active:bg-ink-50" aria-label="View our fleet">
      <%- include('icon', { name: 'car', cls: 'w-5 h-5' }) %>
      <span class="text-[11px] font-medium">Fleet</span>
    </a>
    <a href="https://wa.me/<%= whatsappDigits %>" target="_blank" rel="noopener" class="shine shine-dark flex flex-col items-center justify-center gap-0.5 text-[#128C53] bg-[#25D366]/10 active:bg-[#25D366]/20" aria-label="WhatsApp <%= business.name %>">
      <%- include('icon', { name: 'whatsapp', cls: 'w-5 h-5' }) %>
      <span class="text-[11px] font-medium">WhatsApp</span>
    </a>
    <a href="<%= telHref %>" class="shine shine-dark flex flex-col items-center justify-center gap-0.5 text-ink-600 active:bg-ink-50" aria-label="Call <%= business.name %>">
      <%- include('icon', { name: 'phone', cls: 'w-5 h-5' }) %>
      <span class="text-[11px] font-medium">Call</span>
    </a>
    <button type="button" class="shine flex flex-col items-center justify-center gap-0.5 text-white bg-brand-500 active:bg-brand-600" data-enquiry-trigger data-enquiry-type="quote" data-enquiry-context="General Enquiry" aria-label="Get a free quote">
      <%- include('icon', { name: 'send', cls: 'w-5 h-5' }) %>
      <span class="text-[11px] font-medium">Quote</span>
    </button>
  </div>
</div>
