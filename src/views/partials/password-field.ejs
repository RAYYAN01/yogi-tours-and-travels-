<%
/*
  Reusable labelled password input with a show/hide eye toggle.
  Locals: id, name, label, autocomplete (default "off"), required (default true), minlength (optional).
*/
const __id = id;
const __name = name;
const __label = label;
const __autocomplete = typeof autocomplete !== "undefined" ? autocomplete : "off";
const __required = typeof required === "undefined" || required;
const __minlength = typeof minlength !== "undefined" ? minlength : null;
%>
<div>
  <label for="<%= __id %>" class="form-label"><%= __label %></label>
  <div class="relative">
    <input
      type="password"
      id="<%= __id %>"
      name="<%= __name %>"
      class="form-input pr-10"
      autocomplete="<%= __autocomplete %>"
      <% if (__minlength) { %>minlength="<%= __minlength %>"<% } %>
      <% if (__required) { %>required<% } %>
    />
    <button
      type="button"
      data-toggle-password="<%= __id %>"
      class="absolute inset-y-0 right-0 flex items-center px-3 text-ink-400 hover:text-ink-600"
      aria-label="Show password"
      tabindex="-1"
    >
      <span data-eye-icon><%- include('icon', { name: 'eye', cls: 'w-4 h-4' }) %></span>
      <span data-eye-off-icon hidden><%- include('icon', { name: 'eye-off', cls: 'w-4 h-4' }) %></span>
    </button>
  </div>
</div>
<script>
  if (!window.__pwToggleBound) {
    window.__pwToggleBound = true;
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-toggle-password]');
      if (!btn) return;
      var input = document.getElementById(btn.getAttribute('data-toggle-password'));
      if (!input) return;
      var showing = input.type === 'text';
      input.type = showing ? 'password' : 'text';
      btn.querySelector('[data-eye-icon]').hidden = !showing;
      btn.querySelector('[data-eye-off-icon]').hidden = showing;
      btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
    });
  }
</script>
