<%
const __heading = typeof ctaHeading !== "undefined" ? ctaHeading : "Planning Your Next Journey?";
const __sub = typeof ctaSub !== "undefined" ? ctaSub : "Tell us where you're going, how many people are travelling and what vehicle you need — we'll help you plan the journey and share a clear quotation.";
%>
<section class="relative overflow-hidden bg-gradient-to-br from-brand-800 via-brand-900 to-ink-950">
  <div class="absolute inset-0 ph-pattern-overlay opacity-[0.06]" aria-hidden="true"></div>
  <div class="container relative py-16 lg:py-20 text-center">
    <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-white max-w-2xl mx-auto"><%= __heading %></h2>
    <p class="text-brand-100/80 mt-4 max-w-xl mx-auto text-[15px] leading-relaxed"><%= __sub %></p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-8">
      <button type="button" class="btn btn-accent ring-2 ring-white/40" data-enquiry-trigger data-enquiry-type="quote" data-enquiry-context="General Enquiry">
        <%- include('icon', { name: 'send', cls: 'w-4 h-4' }) %><span>Get a Free Quote</span>
      </button>
      <a href="https://wa.me/<%= whatsappDigits %>" target="_blank" rel="noopener" class="btn btn-white">
        <%- include('icon', { name: 'whatsapp', cls: 'w-4 h-4' }) %><span>WhatsApp Us</span>
      </a>
      <a href="<%= telHref %>" class="btn btn-outline-white">
        <%- include('icon', { name: 'phone', cls: 'w-4 h-4' }) %><span>Call Now</span>
      </a>
    </div>
  </div>
</section>
